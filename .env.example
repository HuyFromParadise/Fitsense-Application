# Copy to .env and adjust. `.env` is git-ignored.
# docker-compose.yml and FitSenseBackend/application.properties read the same variable names.

# --- MySQL ---
DB_NAME=fitsense
DB_USER=fitsense
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# Host port for the MySQL container. 3307 avoids clashing with a local MySQL install.
DB_PORT=3307

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=
# firebase = verify Firebase ID tokens; dev = accept FITSENSE_DEV_TOKEN (local only).
# Leave empty to let the `dev` profile choose "dev".
FITSENSE_AUTH_MODE=
FITSENSE_DEV_TOKEN=dev-token

# --- Firebase Admin SDK (backend) ---
# Absolute path to the service account JSON on the host. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
# docker compose --profile full mounts this path into the backend container.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
# Alternative to a file path: the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
