# Copy to .env and adjust. `.env` is git-ignored.
# docker-compose.yml and FitSenseBackend/application.properties read the same variable names.

# --- MySQL ---
DB_NAME=fitsense
DB_USER=fitsense
DB_USERNAME=root
DB_PASSWORD=change-me
# Host port for the MySQL container. 3307 avoids clashing with a local MySQL install.
DB_PORT=3307
# Local backend -> Docker MySQL (host port). docker-compose overrides this with mysql:3306.
DB_URL=jdbc:mysql://localhost:3307/fitsense_db?serverTimezone=UTC

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=
# firebase = verify Firebase ID tokens; dev = accept FITSENSE_DEV_TOKEN (local only).
# Leave empty to let the `dev` profile choose "dev".
FITSENSE_AUTH_MODE=
FITSENSE_DEV_TOKEN=dev-token

# --- Firebase Admin SDK (backend) ---
# Absolute path to the service account JSON on the host. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
# docker compose --profile full mounts this path into the backend container.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
# Alternative to a file path: the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Maps API Key (Mobile) ---
# Used by react-native-maps in AndroidManifest.xml via manifestPlaceholders.
# Replace with your real Google Maps Android SDK key from Google Cloud Console.
GOOGLE_MAPS_API_KEY=AIzaSyDummyKeyForLocalDevelopment

# --- Internal Notifications Admin Key ---
# Set a non-empty secret to authorize POST /api/notifications/weekly-report/trigger via X-Admin-Key header.
NOTIFICATIONS_ADMIN_KEY=

# --- Android Release Signing (Optional for APK/AAB release builds) ---
FITSENSE_UPLOAD_STORE_FILE=
FITSENSE_UPLOAD_STORE_PASSWORD=
FITSENSE_UPLOAD_KEY_ALIAS=
FITSENSE_UPLOAD_KEY_PASSWORD=

